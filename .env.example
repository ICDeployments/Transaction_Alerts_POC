# Copy this file to .env and populate with your Azure credentials.
# Do not commit .env into source control.

# Azure AI Search configuration
SEARCH_ENDPOINT="https://<your-search-resource>.search.windows.net"
SEARCH_API_KEY="your-azure-search-api-key"
SEARCH_INDEX_NAME="your-search-index-name"

# Azure OpenAI configuration
AZURE_OPENAI_ENDPOINT="https://<your-azure-openai-resource>.openai.azure.com/"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_DEPLOYMENT_NAME="your-deployment-name"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
